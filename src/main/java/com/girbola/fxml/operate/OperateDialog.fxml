<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="460.0" minWidth="640.0" styleClass="operatePane" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.girbola.controllers.operate.OperateDialogController">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <GridPane hgap="12.0" styleClass="operateCard" vgap="6.0" VBox.vgrow="NEVER">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="110.0" prefWidth="130.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
               </columnConstraints>
               <padding>
                  <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
               </padding>
               <children>
                  <Label styleClass="statName" text="%copyFrom" GridPane.rowIndex="0" />
                  <Label fx:id="cp_copyFrom_Input" maxWidth="1.7976931348623157E308" styleClass="statPath" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label styleClass="statName" text="%copyTo" GridPane.rowIndex="1" />
                  <Label fx:id="cp_copyTo_Input" maxWidth="1.7976931348623157E308" styleClass="statPath" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
            </GridPane>
            <GridPane hgap="12.0" styleClass="operateCard" vgap="6.0" VBox.vgrow="NEVER">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="110.0" prefWidth="130.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
               </columnConstraints>
               <padding>
                  <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
               </padding>
               <children>
                  <Label styleClass="statName" text="%copied" GridPane.rowIndex="0" />
                  <Label fx:id="cp_copied_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label styleClass="statName" text="%renamed" GridPane.rowIndex="1" />
                  <Label fx:id="cp_renamedFiles_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label styleClass="statName" text="%duplicated" GridPane.rowIndex="2" />
                  <Label fx:id="cp_duplicatedFiles_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label styleClass="statName" text="%totalFiles" GridPane.rowIndex="3" />
                  <Label fx:id="cp_totalFiles_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label styleClass="statName" text="%filesLeft" GridPane.rowIndex="4" />
                  <Label fx:id="cp_filesLeft_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label styleClass="statName" text="%transferRate" GridPane.rowIndex="5" />
                  <Label fx:id="cp_transferRate_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <Label styleClass="statName" text="%timeLeft" GridPane.rowIndex="6" />
                  <Label fx:id="cp_timeLeft_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  <Label styleClass="statName" text="%timeElapsed" GridPane.rowIndex="7" />
                  <Label fx:id="cp_timeElapsed_Input" maxWidth="1.7976931348623157E308" styleClass="statValue" GridPane.columnIndex="1" GridPane.rowIndex="7" />
               </children>
            </GridPane>
            <GridPane hgap="12.0" styleClass="operateCard" vgap="10.0" VBox.vgrow="NEVER">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="110.0" prefWidth="130.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
               </columnConstraints>
               <padding>
                  <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
               </padding>
               <children>
                  <Label styleClass="statName" text="%fileCopy" GridPane.rowIndex="0" />
                  <ProgressBar fx:id="copyProgressBar" maxWidth="1.7976931348623157E308" progress="0.0" styleClass="kittBar" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />
                  <Label styleClass="statName" text="%totalProgress" GridPane.rowIndex="1" />
                  <ProgressBar fx:id="totalProgressBar" maxWidth="1.7976931348623157E308" progress="0.0" styleClass="kittBar" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
               </children>
            </GridPane>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="8.0" VBox.vgrow="NEVER">
               <children>
                  <Label styleClass="statName" text="%workDir" />
                  <Label fx:id="current_workdir" maxWidth="1.7976931348623157E308" styleClass="statPath" HBox.hgrow="ALWAYS" />
                  <Button fx:id="start_btn" disable="true" mnemonicParsing="false" styleClass="operateButton, startButton" text="Start" />
                  <Button fx:id="cancel_btn" disable="true" mnemonicParsing="false" styleClass="operateButton, cancelButton" text="Cancel" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
