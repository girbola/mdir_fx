<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane minHeight="0.0" minWidth="250.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.girbola.controllers.folderscanner.SelectedFoldersController">
   <children>
      <VBox minHeight="0.0" minWidth="250.0" spacing="4.0" styleClass="folderSelectedTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <children>
              <Label text="%selectedFolders" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="4.0" left="6.0" right="6.0" top="4.0" />
               </padding></Label>
              <TableView fx:id="selectedFolder_TableView" styleClass="selectedFolderTableView" VBox.vgrow="ALWAYS">
                  <columns>
                  <TableColumn fx:id="folder_selected_col" editable="false" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" resizable="false" sortable="false" text="%selected" />
                  <TableColumn fx:id="folder_connected_col" editable="false" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" resizable="false" sortable="false">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="bi-plug" iconSize="20" />
                     </graphic></TableColumn>
                  <TableColumn fx:id="folder_col" editable="false" minWidth="150.0" prefWidth="-1.0" text="%folder" />
                  <TableColumn fx:id="hasMedia_col" editable="false" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" text="%media">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="bi-image" iconSize="20" />
                     </graphic></TableColumn>
                  <TableColumn fx:id="remove_row_col" editable="false" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" resizable="false" sortable="false" />
                  </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
              </TableView>
              <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="6.0" styleClass="selectedFoldersButtonBar" VBox.vgrow="NEVER">
                  <children>
                      <Button fx:id="selectedFolders_ok_btn" mnemonicParsing="false" onAction="#selectedFolders_ok_action" styleClass="sfButton, sfButtonOk" HBox.hgrow="NEVER">
                     <graphic>
                        <FontIcon iconColor="#2bcd4b" iconLiteral="bi-check" iconSize="25" />
                     </graphic>
                      </Button>
                      <Button fx:id="selectedFolders_cancel_btn" mnemonicParsing="false" onAction="#selectedFolders_cancel_action" styleClass="sfButton, sfButtonCancel" HBox.hgrow="NEVER">
                     <graphic>
                        <FontIcon iconColor="#d0d0d0" iconLiteral="bi-x" iconSize="25" />
                     </graphic>
                      </Button>
                  <HBox alignment="CENTER_RIGHT" fillHeight="false" HBox.hgrow="ALWAYS">
                     <children>
                            <Button fx:id="selectedFolders_select_folder_btn" mnemonicParsing="false" onAction="#selectedFolders_select_folder_action" styleClass="sfButton, sfButtonAdd" HBox.hgrow="NEVER">
                           <graphic>
                              <FontIcon iconColor="WHITE" iconLiteral="bi-plus" iconSize="25" selectionFill="#fcfcfc" />
                           </graphic>
                            </Button>
                     </children>
                  </HBox>
                  </children>
                  <padding>
                      <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
                  </padding>
              </HBox>
          </children>
          <padding>
              <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
          </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
   </padding>
</AnchorPane>
