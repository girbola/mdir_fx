<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane minHeight="500.0" minWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.girbola.controllers.folderscanner.SelectedFoldersController">
   <children>
      <VBox minHeight="500.0" minWidth="800.0" styleClass="folderSelectedTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <children>
              <Label text="%selectedFolders" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
               </VBox.margin></Label>
              <TableView fx:id="selectedFolder_TableView" styleClass="selectedFolderTableView" VBox.vgrow="ALWAYS">
                  <columns>
                  <TableColumn fx:id="folder_selected_col" editable="false" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" resizable="false" sortable="false" text="%selected" />
                  <TableColumn fx:id="folder_connected_col" editable="false" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" resizable="false" sortable="false">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="bi-plug" iconSize="20" />
                     </graphic></TableColumn>
                  <TableColumn fx:id="folder_col" editable="false" minWidth="500.0" prefWidth="-1.0" text="%folder" />
                  <TableColumn fx:id="hasMedia_col" editable="false" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" text="%media">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="bi-image" iconSize="20" />
                     </graphic></TableColumn>
                  <TableColumn fx:id="remove_row_col" editable="false" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" resizable="false" sortable="false" />
                  </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
              </TableView>
              <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="5.0" style="-fx-background-color: transparent;" VBox.vgrow="NEVER">
                  <children>
                      <Button fx:id="selectedFolders_ok_btn" minHeight="25.0" mnemonicParsing="false" onAction="#selectedFolders_ok_action" prefHeight="25.0" prefWidth="50.0" style="-fx-background-color: green; -fx-effect: dropshadow( gaussian , rgba(0,0,0,0.7) , 10,0,0,1 ); -fx-background-radius: 5;" HBox.hgrow="NEVER">
                          <font>
                              <Font size="10.0" />
                          </font>
                     <graphic>
                        <FontIcon iconColor="#2bcd4b" iconLiteral="bi-check" iconSize="25" />
                     </graphic>
                      </Button>
                      <Button fx:id="selectedFolders_cancel_btn" minHeight="25.0" mnemonicParsing="false" onAction="#selectedFolders_cancel_action" prefHeight="25.0" prefWidth="50.0" style="-fx-background-color: green; -fx-background-radius: 5; -fx-effect: dropshadow( gaussian , rgba(0,0,0,0.7) , 10,0,0,1 );" HBox.hgrow="NEVER">
                          <VBox.margin>
                              <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
                          </VBox.margin>
                     <graphic>
                        <FontIcon iconColor="#d0d0d0" iconLiteral="bi-x" iconSize="25" />
                     </graphic>
                      </Button>
                  <HBox alignment="CENTER_RIGHT" fillHeight="false" HBox.hgrow="ALWAYS">
                     <children>
                            <Button fx:id="selectedFolders_select_folder_btn" lineSpacing="1.0" minHeight="30.0" mnemonicParsing="false" onAction="#selectedFolders_select_folder_action" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: orange; -fx-effect: dropshadow( gaussian , rgba(0,0,0,0.7) , 10,0,0,1 ); -fx-background-radius: 5;" HBox.hgrow="NEVER">
                           <graphic>
                              <FontIcon iconColor="WHITE" iconLiteral="bi-plus" iconSize="25" selectionFill="#fcfcfc" />
                           </graphic>
                           <HBox.margin>
                              <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                           </HBox.margin>
                            </Button>
                     </children>
                  </HBox>
                  </children>
                  <padding>
                      <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
                  </padding>
              </HBox>
          </children>
          <padding>
              <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
          </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
   </padding>
</AnchorPane>
