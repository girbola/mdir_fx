<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="220.0" minWidth="380.0" prefHeight="240.0" prefWidth="420.0" styleClass="loadingPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.girbola.controllers.loading.LoadingProcessController">
   <children>
      <VBox spacing="10.0" styleClass="shadowPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0" VBox.vgrow="NEVER">
               <children>
                  <Label graphicTextGap="0.0" styleClass="loadingTitle" text="%status" HBox.hgrow="NEVER" />
                  <Label fx:id="messages_lbl" maxWidth="1.7976931348623157E308" styleClass="loadingMessage" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <TextArea fx:id="messages_txa" editable="false" prefRowCount="5" styleClass="loadingLog" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" mouseTransparent="true" VBox.vgrow="NEVER">
               <children>
                  <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" progress="-1.0" styleClass="kittBar" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" VBox.vgrow="NEVER">
               <children>
                  <Button fx:id="cancel_btn" mnemonicParsing="false" onAction="#cancel_btn_action" styleClass="cancelButton" text="%cancel" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
