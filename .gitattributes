# Catch-all: force LF line endings for all text files
* text=auto eol=lf

# Java & Kotlin
*.java      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf

# JavaFX & Resources
*.fxml      text eol=lf
*.css       text eol=lf

# Build & Configuration
*.xml       text eol=lf
*.properties text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.gradle    text eol=lf
*.groovy    text eol=lf
*.pom       text eol=lf

# Documentation & Git
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.gitignore text eol=lf
.gitattributes text eol=lf

# Shell Scripts (Linux/Mac)
*.sh        text eol=lf

# Windows Scripts
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf